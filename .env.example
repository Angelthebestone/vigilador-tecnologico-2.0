VT_APP_ENV=development
VT_APP_HOST=0.0.0.0
VT_APP_PORT=8000

VT_MINIMAX_API_KEY=
VT_MINIMAX_MODEL=MiniMax-M2.7
VT_MINIMAX_BASE_URL=https://api.minimax.chat/v1

VT_EMBEDDING_API_KEY=
VT_EMBEDDING_MODEL=gemini-embedding-2
VT_EMBEDDING_DIMENSIONS=768
VT_EMBEDDING_BATCH_SIZE=16

VT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vigilancia

# === MCP PROVIDERS ===
VT_MCP_DEFAULT_TIMEOUT_MS=30000
VT_MCP_DEFAULT_RETRY_LIMIT=2

# Tavily MCP — https://mcp.tavily.com/mcp/?tavilyApiKey=<key>
# Get key: https://www.tavily.com/
#VT_TAVILY_API_KEY=

# Exa MCP — https://mcp.exa.ai/mcp
# Get key: https://dashboard.exa.ai/api-keys
#VT_EXA_API_KEY=

# Jina MCP — https://mcp.jina.ai/v1 (Authorization: Bearer)
# Get key: https://jina.ai/
#VT_JINA_API_KEY=

# Brave Search MCP — npx @brave/brave-search-mcp-server
# Get key: https://brave.com/search/api/
#VT_BRAVE_API_KEY=

# Firecrawl MCP — npx firecrawl-mcp
# Get key: https://www.firecrawl.dev/app/api-keys
#VT_FIRECRAWL_API_KEY=

# Serper REST API — https://google.serper.dev/{news|patents|scholar}
# Get key: https://serper.dev/
#VT_SERPER_API_KEY=
