VT_APP_ENV=development
VT_APP_HOST=0.0.0.0
VT_APP_PORT=8000
VT_MINIMAX_API_KEY=
VT_MINIMAX_MODEL=MiniMax-M2.7
VT_MINIMAX_BASE_URL=https://api.minimax.io
VT_EMBEDDING_API_KEY=
VT_EMBEDDING_MODEL=gemini-embedding-2
VT_EMBEDDING_DIMENSIONS=768
VT_EMBEDDING_BATCH_SIZE=16
# Formato: postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# Reemplaza CONTRASEÑA por la clave real del usuario postgres definida al instalar PostgreSQL.
# Si la contraseña tiene caracteres especiales (@ : / # ?) hay que URL-encodearlos
# (ej: @ -> %40, # -> %23). La base 'vigilancia' debe existir (createdb vigilancia).
VT_DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/vigilancia
VT_MCP_DEFAULT_TIMEOUT_MS=30000
VT_MCP_DEFAULT_RETRY_LIMIT=2
VT_TAVILY_API_KEY=
VT_EXA_API_KEY=
VT_JINA_API_KEY=
VT_BRAVE_API_KEY=
VT_FIRECRAWL_API_KEY=
VT_SERPER_API_KEY=
# Opcional: reranker semántico (Cohere Rerank). Si se deja vacío, el sistema
# usa fallback con los embeddings Gemini (sin coste extra, menor precisión).
VT_COHERE_API_KEY=
# OpenAlex (datos bibliométricos: citas, instituciones, redes de coautoría).
# La API pública es gratis y sin autenticación. Poner el email institucional
# entra en el "polite pool" (rate limits más estables). La API key es opcional
# (solo usuarios premium: límites más altos). Usados por el cliente REST y el
# MCP openalex-research-mcp (31 herramientas).
VT_OPENALEX_EMAIL=
VT_OPENALEX_API_KEY=
VT_MINIMAX_IMAGE_API_KEY=
VT_MINIMAX_API_HOST=https://api.minimax.io
VT_PLAYWRIGHT_HEADLESS=true
VT_MARKITDOWN_TIMEOUT=60000
VT_SANDBOX_TIMEOUT=120
VT_SANDBOX_MAX_OUTPUT_SIZE=1048576
