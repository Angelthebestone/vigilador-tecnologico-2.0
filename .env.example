# ============================================================================
# .env.example — Vigilador Tecnológico
# Solo se declaran SECRETOS (API keys) y la cadena de conexión con credenciales.
# Toda la demás configuración (hosts, puertos, modelos, timeouts, flags, paths,
# tenant, observabilidad, health monitor, workstreams...) usa valores por
# defecto en src/vigilancia_multiagente/config/settings.py
# (principio constitucional "Convención sobre Configuración").
# Para invalidar un default, declara la variable como VT_<CAMPO> en tu .env.
# ============================================================================

# --- Base de datos (contiene credenciales; personalizar obligatorio) ---------
# Formato: postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# Reemplaza CONTRASEÑA por la clave real del usuario postgres.
# URL-encodea caracteres especiales en la contraseña (@ -> %40, # -> %23).
# La base 'vigilancia' debe existir (createdb vigilancia).
VT_DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/vigilancia

# --- LLM ---------------------------------------------------------------------
# Xiaomimimo: LLM default del MVP. API key en https://platform.xiaomimimo.com
VT_XIAOMIMIMO_API_KEY=
# MiniMax: adapter opcional / LLM del 2.0 (chat + imagen).
VT_MINIMAX_API_KEY=
VT_MINIMAX_IMAGE_API_KEY=

# --- Embeddings y reranker ---------------------------------------------------
VT_EMBEDDING_API_KEY=
# Cohere Rerank (opcional). Vacío => fallback con embeddings Gemini.
VT_COHERE_API_KEY=

# --- MCP / búsqueda web (opcionales; degradan a None si faltan) --------------
VT_TAVILY_API_KEY=
VT_EXA_API_KEY=
VT_JINA_API_KEY=
VT_BRAVE_API_KEY=
VT_FIRECRAWL_API_KEY=
VT_SERPER_API_KEY=

# --- OpenAlex (opcional; API key solo para usuarios premium) -----------------
VT_OPENALEX_API_KEY=

# --- Fact-checking externo (opcional; Spec 007 WS-A) -------------------------
VT_GOOGLE_FACTCHECK_API_KEY=

# --- Google Workspace OAuth (Spec 021 — F2 ingestion connector Drive) --------
# OAuth client del proveedor `google_workspace` (capabilities: read_docs,
# write_docs, read_sheets, send_email). Scopes sin permiso de borrado.
# El token de servicio se cifra con Fernet en `~/.vigilador/credentials/`.
# NO se usa para auth de usuario (eliminada por D4).
VT_GOOGLE_CLIENT_ID=
VT_GOOGLE_CLIENT_SECRET=
