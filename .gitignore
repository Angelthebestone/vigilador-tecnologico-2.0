# =====================================================================
# Vigilador Tecnológico — .gitignore
# Backend: Python 3.11 / FastAPI · Frontend: Vite + React + TypeScript
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Sandbox audit logs
logs/

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example

# ---------- Node / frontend (Vite + React) ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Generated artifacts ----------
openapi.json
*.tsbuildinfo

# ---------- MCP servers (third-party, vendored separately) ----------
.mcp-servers/

# ---------- Editors / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Temp / logs ----------
*.log
*.tmp

# ---------- Uploads (temp files for Markitdown conversion) ----------
uploads/

# ---------- Documentation (third-party READMEs) ----------
documentation/

# ---------- Specs / feature artifacts ----------
specs/

# ---------- Speckit tooling (external) ----------
.specify/extensions/
.specify/integrations/
.specify/scripts/
.specify/templates/
.specify/workflows/
.specify/memory/
.specify/feature.json
.specify/extensions.yml
.specify/init-options.json
.specify/integration.json

# ---------- .claude (external config/worktrees/skills) ----------
.claude/

# ---------- .github (external CI/skills) ----------
.github/

# ---------- .opencode agents, prompts & skills (external) ----------
.opencode/agents/
.opencode/prompts/
.opencode/skills/
.opencode/plans/

# ---------- .speckit-backup ----------
*.speckit-backup

# ---------- Standalone spec files in root ----------
SPEC_V2.md

PLAN_DE_AUDITORIA.md
ARQUITECTURA.md

# ---------- Heap snapshots (pueden contener secretos en memoria) ----------
*.heapsnapshot
