*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example

# ---------- Node / frontend (Vite + React) ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Generated artifacts ----------
openapi.json
*.tsbuildinfo

# ---------- MCP servers (third-party, vendored separately) ----------
.mcp-servers/

# ---------- Editors / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs / temp ----------
logs/
*.log
*.tmp

