.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Temp / logs ----------
*.log
*.tmp

# ---------- Uploads (temp files for Markitdown conversion) ----------
uploads/

